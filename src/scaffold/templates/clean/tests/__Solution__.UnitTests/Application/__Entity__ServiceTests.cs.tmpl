namespace {{Solution}}.UnitTests.Application;

using Microsoft.Extensions.Logging.Abstractions;
using Xunit;
using {{Solution}}.Application.{{EntityPlural}};
using {{Solution}}.UnitTests.Fakes;

public class {{Entity}}ServiceTests
{
    private static ({{Entity}}Service Service, InMemory{{Entity}}Repository Repository) CreateSut()
    {
        var repository = new InMemory{{Entity}}Repository();
        var service = new {{Entity}}Service(repository, repository, NullLogger<{{Entity}}Service>.Instance);
        return (service, repository);
    }

    [Fact]
    public async Task CreateAsync_persiste_y_confirma_la_unidad_de_trabajo()
    {
        var (service, repository) = CreateSut();

        var result = await service.CreateAsync(new Create{{Entity}}Request("Teclado", "KB-1", 49.9m, 3));

        Assert.True(result.IsSuccess);
        Assert.Equal("KB-1", result.Value.Sku);
        Assert.Equal(1, repository.SaveChangesCalls);
    }

    [Fact]
    public async Task CreateAsync_rechaza_sku_duplicado_con_conflicto()
    {
        var (service, _) = CreateSut();
        await service.CreateAsync(new Create{{Entity}}Request("Teclado", "KB-1", 49.9m, 3));

        var duplicated = await service.CreateAsync(new Create{{Entity}}Request("Otro", "KB-1", 10m, 1));

        Assert.True(duplicated.IsFailure);
        Assert.Equal("conflict", duplicated.Error!.Code);
    }

    [Fact]
    public async Task CreateAsync_traduce_la_excepcion_de_dominio_a_error_de_validacion()
    {
        var (service, _) = CreateSut();

        var result = await service.CreateAsync(new Create{{Entity}}Request("", "KB-1", 10m, 1));

        Assert.True(result.IsFailure);
        Assert.Equal("validation", result.Error!.Code);
    }

    [Fact]
    public async Task GetAsync_devuelve_not_found_si_no_existe()
    {
        var (service, _) = CreateSut();

        var result = await service.GetAsync(Guid.NewGuid());

        Assert.True(result.IsFailure);
        Assert.Equal("not_found", result.Error!.Code);
    }

    [Fact]
    public async Task UpdateAsync_aplica_el_delta_de_stock()
    {
        var (service, _) = CreateSut();
        var created = await service.CreateAsync(new Create{{Entity}}Request("Teclado", "KB-1", 49.9m, 3));

        var updated = await service.UpdateAsync(created.Value.Id, new Update{{Entity}}Request("Teclado Pro", 59.9m, 2));

        Assert.True(updated.IsSuccess);
        Assert.Equal("Teclado Pro", updated.Value.Name);
        Assert.Equal(5, updated.Value.Stock);
        Assert.Equal(59.90m, updated.Value.Price);
    }

    [Fact]
    public async Task DeleteAsync_elimina_y_deja_de_listarlo()
    {
        var (service, _) = CreateSut();
        var created = await service.CreateAsync(new Create{{Entity}}Request("Teclado", "KB-1", 49.9m, 3));

        var deleted = await service.DeleteAsync(created.Value.Id);
        var remaining = await service.ListAsync(search: null);

        Assert.True(deleted.IsSuccess);
        Assert.Empty(remaining);
    }

    [Fact]
    public async Task ListAsync_filtra_por_nombre_o_sku()
    {
        var (service, _) = CreateSut();
        await service.CreateAsync(new Create{{Entity}}Request("Teclado", "KB-1", 49.9m, 3));
        await service.CreateAsync(new Create{{Entity}}Request("Monitor", "MON-1", 199m, 2));

        var byName = await service.ListAsync("monitor");
        var bySku = await service.ListAsync("KB");

        Assert.Single(byName);
        Assert.Single(bySku);
        Assert.Equal("Monitor", byName[0].Name);
    }
}
