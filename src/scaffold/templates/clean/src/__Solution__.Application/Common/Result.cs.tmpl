namespace {{Solution}}.Application.Common;

/// <summary>Motivo de fallo de un caso de uso, con un código estable para la capa web.</summary>
public sealed record Error(string Code, string Message)
{
    public static Error NotFound(string what) => new("not_found", $"No se ha encontrado {what}.");

    public static Error Validation(string message) => new("validation", message);

    public static Error Conflict(string message) => new("conflict", message);
}

/// <summary>
/// Resultado explícito de un caso de uso. Evita usar excepciones para el flujo de control
/// esperado (no encontrado, validación, conflicto) y obliga a la capa web a tratar el fallo.
/// </summary>
public class Result
{
    protected Result(bool isSuccess, Error? error)
    {
        IsSuccess = isSuccess;
        Error = error;
    }

    public bool IsSuccess { get; }

    public bool IsFailure => !IsSuccess;

    public Error? Error { get; }

    public static Result Success() => new(true, null);

    public static Result Failure(Error error) => new(false, error);

    public static Result<TValue> Success<TValue>(TValue value) => Result<TValue>.Ok(value);

    public static Result<TValue> Failure<TValue>(Error error) => Result<TValue>.Fail(error);
}

/// <summary>Resultado que transporta un valor cuando la operación tiene éxito.</summary>
public sealed class Result<TValue> : Result
{
    private readonly TValue? _value;

    private Result(bool isSuccess, TValue? value, Error? error) : base(isSuccess, error)
        => _value = value;

    /// <summary>Valor de la operación. Sólo es válido si <see cref="Result.IsSuccess"/> es true.</summary>
    public TValue Value => IsSuccess
        ? _value!
        : throw new InvalidOperationException("No se puede leer el valor de un resultado fallido.");

    internal static Result<TValue> Ok(TValue value) => new(true, value, null);

    internal static Result<TValue> Fail(Error error) => new(false, default, error);
}
