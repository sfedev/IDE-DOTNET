namespace {{Solution}}.Infrastructure.Persistence.Repositories;

using Microsoft.EntityFrameworkCore;
using {{Solution}}.Application.Abstractions;
using {{Solution}}.Domain.Entities;

/// <summary>Implementación EF Core del puerto <see cref="I{{Entity}}Repository"/>.</summary>
public sealed class {{Entity}}Repository : I{{Entity}}Repository
{
    private readonly AppDbContext _context;

    public {{Entity}}Repository(AppDbContext context) => _context = context;

    public async Task<IReadOnlyList<{{Entity}}>> ListAsync(string? search, CancellationToken cancellationToken = default)
    {
        var query = _context.{{EntityPlural}}.AsNoTracking();

        if (!string.IsNullOrWhiteSpace(search))
        {
            var term = search.Trim();
            query = query.Where(x => EF.Functions.Like(x.Name, $"%{term}%") || EF.Functions.Like(x.Sku, $"%{term}%"));
        }

        return await query
            .OrderBy(x => x.Name)
            .ToListAsync(cancellationToken);
    }

    public Task<{{Entity}}?> GetByIdAsync(Guid id, CancellationToken cancellationToken = default)
        => _context.{{EntityPlural}}.FirstOrDefaultAsync(x => x.Id == id, cancellationToken);

    public Task<bool> SkuExistsAsync(string sku, Guid? excludingId = null, CancellationToken cancellationToken = default)
    {
        var normalized = sku.Trim().ToUpperInvariant();
        return _context.{{EntityPlural}}
            .AsNoTracking()
            .AnyAsync(x => x.Sku == normalized && (excludingId == null || x.Id != excludingId), cancellationToken);
    }

    public async Task AddAsync({{Entity}} {{entity}}, CancellationToken cancellationToken = default)
        => await _context.{{EntityPlural}}.AddAsync({{entity}}, cancellationToken);

    public void Remove({{Entity}} {{entity}}) => _context.{{EntityPlural}}.Remove({{entity}});
}
