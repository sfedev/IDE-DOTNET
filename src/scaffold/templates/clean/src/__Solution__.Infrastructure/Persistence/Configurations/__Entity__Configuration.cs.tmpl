namespace {{Solution}}.Infrastructure.Persistence.Configurations;

using Microsoft.EntityFrameworkCore;
using Microsoft.EntityFrameworkCore.Metadata.Builders;
using {{Solution}}.Domain.Entities;

/// <summary>
/// Mapeo de <see cref="{{Entity}}"/>. El dominio no lleva atributos de persistencia: todo el
/// conocimiento del esquema se concentra aquí.
/// </summary>
public sealed class {{Entity}}Configuration : IEntityTypeConfiguration<{{Entity}}>
{
    public void Configure(EntityTypeBuilder<{{Entity}}> builder)
    {
        builder.ToTable("{{EntityPlural}}");

        builder.HasKey(x => x.Id);

        builder.Property(x => x.Name)
            .IsRequired()
            .HasMaxLength(120);

        builder.Property(x => x.Sku)
            .IsRequired()
            .HasMaxLength(32);

        builder.HasIndex(x => x.Sku).IsUnique();

        builder.Property(x => x.Stock).IsRequired();
        builder.Property(x => x.CreatedAtUtc).IsRequired();

        // Money es un objeto de valor: se aplana en columnas de la tabla dueña.
        builder.OwnsOne(x => x.Price, price =>
        {
            price.Property(p => p.Amount)
                .HasColumnName("PriceAmount")
                .HasPrecision(18, 2)
                .IsRequired();

            price.Property(p => p.Currency)
                .HasColumnName("PriceCurrency")
                .HasMaxLength(3)
                .IsRequired();
        });

        builder.Navigation(x => x.Price).IsRequired();
    }
}
