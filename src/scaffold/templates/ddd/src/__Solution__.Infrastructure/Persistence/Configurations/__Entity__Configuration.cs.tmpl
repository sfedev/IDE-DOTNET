namespace {{Solution}}.Infrastructure.Persistence.Configurations;

using Microsoft.EntityFrameworkCore;
using Microsoft.EntityFrameworkCore.Metadata.Builders;
using {{Solution}}.Domain.{{EntityPlural}};

/// <summary>
/// Mapeo del agregado. Los objetos de valor se aplanan como owned types y los eventos de dominio
/// se ignoran: son estado en memoria, no columnas.
/// </summary>
public sealed class {{Entity}}Configuration : IEntityTypeConfiguration<{{Entity}}>
{
    public void Configure(EntityTypeBuilder<{{Entity}}> builder)
    {
        builder.ToTable("{{EntityPlural}}");
        builder.HasKey(x => x.Id);

        builder.Ignore(x => x.DomainEvents);

        builder.Property(x => x.Name).IsRequired().HasMaxLength(120);
        builder.Property(x => x.Stock).IsRequired();
        builder.Property(x => x.CreatedAtUtc).IsRequired();

        builder.OwnsOne(x => x.Sku, sku =>
        {
            sku.Property(s => s.Value)
                .HasColumnName("Sku")
                .HasMaxLength(Sku.MaxLength)
                .IsRequired();

            sku.HasIndex(s => s.Value).IsUnique();
        });

        builder.OwnsOne(x => x.Price, price =>
        {
            price.Property(p => p.Amount).HasColumnName("PriceAmount").HasPrecision(18, 2).IsRequired();
            price.Property(p => p.Currency).HasColumnName("PriceCurrency").HasMaxLength(3).IsRequired();
        });

        builder.Navigation(x => x.Sku).IsRequired();
        builder.Navigation(x => x.Price).IsRequired();
    }
}
