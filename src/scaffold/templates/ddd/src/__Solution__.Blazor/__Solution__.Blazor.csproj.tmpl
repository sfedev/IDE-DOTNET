<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Presentación Blazor (render interactivo en servidor).
    Consume directamente los casos de uso de Application: sin HttpClient de por medio, sin
    duplicar DTOs y con Hot Reload inmediato mediante `dotnet watch`.
  -->
  <PropertyGroup>
    <RootNamespace>{{Solution}}.Blazor</RootNamespace>
    <AssemblyName>{{Solution}}.Blazor</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Serilog.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\{{Solution}}.Application\{{Solution}}.Application.csproj" />
    <ProjectReference Include="..\{{Solution}}.Infrastructure\{{Solution}}.Infrastructure.csproj" />
  </ItemGroup>

</Project>
