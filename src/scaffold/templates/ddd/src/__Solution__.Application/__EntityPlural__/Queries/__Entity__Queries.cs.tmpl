public sealed class Get{{Entity}}ByIdHandler : IQueryHandler<Get{{Entity}}ByIdQuery, {{Entity}}Response>
{
    private readonly I{{Entity}}Repository _repository;

    public Get{{Entity}}ByIdHandler(I{{Entity}}Repository repository) => _repository = repository;

    public async Task<Result<{{Entity}}Response>> HandleAsync(
        Get{{Entity}}ByIdQuery query,
        CancellationToken cancellationToken = default)
    {
        var found = await _repository.GetByIdAsync(query.Id, cancellationToken);
        return found is null
            ? Result.Failure<{{Entity}}Response>(Error.NotFound($"el {{entity}} {query.Id}"))
            : Result.Success({{Entity}}Response.From(found));
    }
}
