public sealed record Get{{Entity}}ByIdQuery(Guid Id) : IQuery<{{Entity}}Response>;

public sealed class List{{EntityPlural}}Handler
    : IQueryHandler<List{{EntityPlural}}Query, IReadOnlyList<{{Entity}}Response>>
{
    private readonly I{{Entity}}Repository _repository;

    public List{{EntityPlural}}Handler(I{{Entity}}Repository repository) => _repository = repository;

    public async Task<Result<IReadOnlyList<{{Entity}}Response>>> HandleAsync(
        List{{EntityPlural}}Query query,
