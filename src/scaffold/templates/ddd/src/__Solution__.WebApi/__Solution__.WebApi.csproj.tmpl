<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Capa de presentación HTTP. Es la raíz de composición: el único proyecto que conoce
    Infrastructure, y sólo para registrarla en el contenedor.
  -->
  <PropertyGroup>
    <RootNamespace>{{Solution}}.WebApi</RootNamespace>
    <AssemblyName>{{Solution}}.WebApi</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Scalar.AspNetCore" />
    <PackageReference Include="Serilog.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\{{Solution}}.Application\{{Solution}}.Application.csproj" />
    <ProjectReference Include="..\{{Solution}}.Infrastructure\{{Solution}}.Infrastructure.csproj" />
  </ItemGroup>

</Project>
