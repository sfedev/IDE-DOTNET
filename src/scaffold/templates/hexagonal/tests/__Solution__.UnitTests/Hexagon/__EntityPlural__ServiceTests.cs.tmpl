namespace {{Solution}}.UnitTests.Hexagon;

using Microsoft.Extensions.Logging.Abstractions;
using Xunit;
using {{Solution}}.Ports.Application;
using {{Solution}}.Ports.Inbound;
using {{Solution}}.UnitTests.Adapters;

/// <summary>
/// Ejercita el hexágono completo a través de su puerto de entrada, con adaptadores dobles.
/// Ni base de datos, ni servidor web, ni reloj real.
/// </summary>
public class {{EntityPlural}}ServiceTests
{
    private sealed record Sut(
        IManage{{EntityPlural}} Port,
        InMemory{{Entity}}Adapter Repository,
        RecordingNotificationAdapter Notifications,
        FrozenClockAdapter Clock);

    private static Sut CreateSut()
    {
        var repository = new InMemory{{Entity}}Adapter();
        var notifications = new RecordingNotificationAdapter();
        var clock = new FrozenClockAdapter();
        var service = new {{EntityPlural}}Service(repository, notifications, clock, NullLogger<{{EntityPlural}}Service>.Instance);
        return new Sut(service, repository, notifications, clock);
    }

    [Fact]
    public async Task RegisterAsync_persiste_confirma_y_notifica()
    {
        var sut = CreateSut();

        var result = await sut.Port.RegisterAsync(new Register{{Entity}}Command("Teclado", "KB-1", 49.9m, 3));

        Assert.True(result.IsSuccess);
        Assert.Equal(1, sut.Repository.Commits);
        Assert.Equal(["KB-1"], sut.Notifications.Registered);
    }

    [Fact]
    public async Task RegisterAsync_usa_el_reloj_inyectado()
    {
        var sut = CreateSut();

        var result = await sut.Port.RegisterAsync(new Register{{Entity}}Command("Teclado", "KB-1", 49.9m, 3));

        Assert.Equal(sut.Clock.UtcNow, result.Value.CreatedAtUtc);
    }

    [Fact]
    public async Task RegisterAsync_rechaza_sku_duplicado()
    {
        var sut = CreateSut();
        await sut.Port.RegisterAsync(new Register{{Entity}}Command("Teclado", "KB-1", 49.9m, 3));

        var duplicated = await sut.Port.RegisterAsync(new Register{{Entity}}Command("Otro", "KB-1", 10m, 1));

        Assert.True(duplicated.IsFailure);
        Assert.Equal("conflict", duplicated.Error!.Code);
    }

    [Fact]
    public async Task RegisterAsync_traduce_la_excepcion_de_dominio_a_validacion()
    {
        var sut = CreateSut();

        var result = await sut.Port.RegisterAsync(new Register{{Entity}}Command("", "KB-1", 10m, 1));

        Assert.True(result.IsFailure);
        Assert.Equal("validation", result.Error!.Code);
    }

    [Fact]
    public async Task FindAsync_devuelve_not_found_si_no_existe()
    {
        var sut = CreateSut();

        var result = await sut.Port.FindAsync(Guid.NewGuid());

        Assert.True(result.IsFailure);
        Assert.Equal("not_found", result.Error!.Code);
    }

    [Fact]
    public async Task AmendAsync_aplica_el_delta_de_stock_y_marca_la_hora()
    {
        var sut = CreateSut();
        var created = await sut.Port.RegisterAsync(new Register{{Entity}}Command("Teclado", "KB-1", 49.9m, 3));

        sut.Clock.UtcNow = sut.Clock.UtcNow.AddHours(2);
        var amended = await sut.Port.AmendAsync(created.Value.Id, new Amend{{Entity}}Command("Teclado Pro", 59.9m, 2));

        Assert.True(amended.IsSuccess);
        Assert.Equal("Teclado Pro", amended.Value.Name);
        Assert.Equal(5, amended.Value.Stock);
        Assert.Equal(sut.Clock.UtcNow, amended.Value.UpdatedAtUtc);
    }

    [Fact]
    public async Task WithdrawAsync_elimina_y_notifica()
    {
        var sut = CreateSut();
        var created = await sut.Port.RegisterAsync(new Register{{Entity}}Command("Teclado", "KB-1", 49.9m, 3));

        var withdrawn = await sut.Port.WithdrawAsync(created.Value.Id);
        var remaining = await sut.Port.BrowseAsync(search: null);

        Assert.True(withdrawn.IsSuccess);
        Assert.Empty(remaining);
        Assert.Equal(["KB-1"], sut.Notifications.Withdrawn);
    }

    [Fact]
    public async Task BrowseAsync_filtra_por_nombre_o_sku()
    {
        var sut = CreateSut();
        await sut.Port.RegisterAsync(new Register{{Entity}}Command("Teclado", "KB-1", 49.9m, 3));
        await sut.Port.RegisterAsync(new Register{{Entity}}Command("Monitor", "MON-1", 199m, 2));

        var byName = await sut.Port.BrowseAsync("monitor");
        var bySku = await sut.Port.BrowseAsync("KB");

        Assert.Single(byName);
        Assert.Single(bySku);
        Assert.Equal("Monitor", byName[0].Name);
    }
}
