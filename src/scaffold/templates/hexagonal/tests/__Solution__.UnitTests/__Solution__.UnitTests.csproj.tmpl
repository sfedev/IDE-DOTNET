<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Pruebas del núcleo y del hexágono completo con adaptadores dobles en memoria.
    Que esto sea posible sin arrancar base de datos ni servidor web es el beneficio concreto
    de la arquitectura hexagonal.
  -->
  <PropertyGroup>
    <RootNamespace>{{Solution}}.UnitTests</RootNamespace>
    <AssemblyName>{{Solution}}.UnitTests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\{{Solution}}.Domain\{{Solution}}.Domain.csproj" />
    <ProjectReference Include="..\..\src\{{Solution}}.Ports\{{Solution}}.Ports.csproj" />
  </ItemGroup>

</Project>
