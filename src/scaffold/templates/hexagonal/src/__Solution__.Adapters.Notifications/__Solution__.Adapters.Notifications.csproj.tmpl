<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Adaptador CONDUCIDO no persistente. Demuestra que un puerto de salida puede ser cualquier
    cosa del exterior: correo, cola de mensajes, webhook o, como aquí, el log.
  -->
  <PropertyGroup>
    <RootNamespace>{{Solution}}.Adapters.Notifications</RootNamespace>
    <AssemblyName>{{Solution}}.Adapters.Notifications</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\{{Solution}}.Ports\{{Solution}}.Ports.csproj" />
  </ItemGroup>

</Project>
