<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Adaptador CONDUCTOR de interfaz de usuario. Invoca el puerto de entrada directamente:
    sin HttpClient de por medio, sin duplicar contratos y con Hot Reload vía `dotnet watch`.
  -->
  <PropertyGroup>
    <RootNamespace>{{Solution}}.Adapters.Blazor</RootNamespace>
    <AssemblyName>{{Solution}}.Adapters.Blazor</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Serilog.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\{{Solution}}.Ports\{{Solution}}.Ports.csproj" />
    <ProjectReference Include="..\{{Solution}}.Adapters.Persistence\{{Solution}}.Adapters.Persistence.csproj" />
    <ProjectReference Include="..\{{Solution}}.Adapters.Notifications\{{Solution}}.Adapters.Notifications.csproj" />
  </ItemGroup>

</Project>
