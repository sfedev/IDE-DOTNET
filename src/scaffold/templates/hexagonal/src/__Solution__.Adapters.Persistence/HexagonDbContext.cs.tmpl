namespace {{Solution}}.Adapters.Persistence;

using Microsoft.EntityFrameworkCore;
using Microsoft.EntityFrameworkCore.Metadata.Builders;
using {{Solution}}.Domain.Model;

/// <summary>
/// Detalle interno del adaptador de persistencia. El hexágono no lo conoce: fuera de este
/// proyecto nadie debería poder nombrar este tipo.
/// </summary>
internal sealed class HexagonDbContext : DbContext
{
    public HexagonDbContext(DbContextOptions<HexagonDbContext> options) : base(options)
    {
    }

    public DbSet<{{Entity}}> {{EntityPlural}} => Set<{{Entity}}>();

    protected override void OnModelCreating(ModelBuilder modelBuilder)
    {
        modelBuilder.ApplyConfiguration(new {{Entity}}Mapping());
        base.OnModelCreating(modelBuilder);
    }
}

/// <summary>Mapeo relacional del modelo. El núcleo no lleva atributos de persistencia.</summary>
internal sealed class {{Entity}}Mapping : IEntityTypeConfiguration<{{Entity}}>
{
    public void Configure(EntityTypeBuilder<{{Entity}}> builder)
    {
        builder.ToTable("{{EntityPlural}}");
        builder.HasKey(x => x.Id);

        builder.Property(x => x.Name).IsRequired().HasMaxLength(120);
        builder.Property(x => x.Sku).IsRequired().HasMaxLength(32);
        builder.HasIndex(x => x.Sku).IsUnique();
        builder.Property(x => x.Stock).IsRequired();
        builder.Property(x => x.CreatedAtUtc).IsRequired();

        builder.OwnsOne(x => x.Price, price =>
        {
            price.Property(p => p.Amount).HasColumnName("PriceAmount").HasPrecision(18, 2).IsRequired();
            price.Property(p => p.Currency).HasColumnName("PriceCurrency").HasMaxLength(3).IsRequired();
        });

        builder.Navigation(x => x.Price).IsRequired();
    }
}
